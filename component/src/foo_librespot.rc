IDD_PREFERENCES DIALOGEX 0, 0, 320, 204
STYLE DS_SETFONT | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Bridge status:",IDC_STATIC,10,8,60,8
    LTEXT           "Checking...",IDC_STATUS,10,20,300,24
    PUSHBUTTON      "Log in...",IDC_LOGIN,10,48,60,14
    PUSHBUTTON      "Refresh",IDC_REFRESH,76,48,60,14
    PUSHBUTTON      "Log out",IDC_LOGOUT,142,48,60,14
    LTEXT           "Streaming bitrate:",IDC_STATIC,10,72,68,8
    COMBOBOX        IDC_BITRATE,82,70,110,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Sync playlists every:",IDC_STATIC,10,92,68,8
    COMBOBOX        IDC_SYNC,82,90,140,90,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Playlist name prefix:",IDC_STATIC,10,112,68,8
    EDITTEXT        IDC_PREFIX,82,110,220,14,ES_AUTOHSCROLL
    LTEXT           "Audio cache size:",IDC_STATIC,10,132,68,8
    COMBOBOX        IDC_CACHE,82,130,110,90,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Clear cache",IDC_CACHE_CLEAR,198,130,60,14
    LTEXT           "",IDC_CACHE_INFO,82,148,228,10
    CONTROL         "Report plays to Spotify (recently played, listening history)",IDC_REPORT_PLAYS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,164,300,10
    LTEXT           "Playlists linked to Spotify are named <prefix><name>; Off disables the sync timer.",
                    IDC_STATIC,10,184,300,10
END

IDD_ADD_LINK DIALOGEX 0, 0, 360, 208
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add Spotify link"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Paste Spotify URIs or open.spotify.com links, one per line:",IDC_HINT,10,8,340,16
    EDITTEXT        IDC_LINKS,10,26,340,152,ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    DEFPUSHBUTTON   "OK",IDOK,244,186,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,300,186,50,14
END

IDD_PLAYLIST_NAME DIALOGEX 0, 0, 300, 78
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Playlist name"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Name:",IDC_STATIC,10,10,40,8
    EDITTEXT        IDC_PLAYLIST_NAME,10,22,280,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,184,54,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,240,54,50,14
END

